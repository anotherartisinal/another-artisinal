# ============================================================
# Another Artisanal — environment variables
# Copy to `.env` for local `netlify dev`, and set the same keys in the
# Netlify dashboard (Site settings → Environment variables) for prod.
# NEVER commit the real .env — it is gitignored.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Project URL + SERVICE ROLE key (server-side only; bypasses RLS).
# Also replace the Supabase host in `_headers` CSP connect-src.
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The public anon key is inlined in the client HTML (checkout/account),
# not read from env. Kept here for reference / local tooling.
SUPABASE_ANON_KEY=

# ── Stripe ──────────────────────────────────────────────────
# Secret key (test: sk_test_… / live: sk_live_…). The matching publishable
# key (pk_test_… / pk_live_…) is INLINED in checkout.html — flip both in the
# SAME commit when switching test↔live or Elements 400s.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (transactional email) ────────────────────────────
RESEND_API_KEY=
# Verified sending domain drives the From addresses in the functions.

# ── Admin panel (/admin.html) ───────────────────────────────
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
ADMIN_NOTIFICATION_EMAIL=

# ── Shipping (INACTIVE until accounts exist — safe to leave blank) ──
# InPost ShipX (PL)
INPOST_API_TOKEN=
INPOST_ORGANIZATION_ID=
INPOST_GEOWIDGET_TOKEN=
# DHL Express (MyDHL API) — EU Express + non-EU
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_TEST_MODE=true
DHL_SENDER_PHONE=
# DHL24 / DHL Parcel Polska (SOAP) — PL domestic + EU Standard
DHL24_API_V2_LOGIN=
DHL24_API_V2_PASSWORD=
DHL24_API_PS_LOGIN=
DHL24_API_PS_PASSWORD=
DHL24_SAP_NUMBER=
DHL24_TEST_MODE=true
